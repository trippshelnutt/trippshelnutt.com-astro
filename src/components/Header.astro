---
import MobileNavigation from "./MobileNavigation.astro";
---

<header>
  <img src="/images/bricks.jpg" />
  <h1>Tripp Shelnutt</h1>
  <MobileNavigation />
</header>

<style>
  header {
    @apply flex-none h-24 flex flex-row justify-center items-center gap-4 mb-8;
  }

  img {
    @apply h-24 w-24 border-4 border-indigo-400 rounded-full;
  }

  h1 {
    @apply text-4xl lg:text-6xl font-extrabold bg-clip-text text-transparent bg-gradient-to-br from-fuchsia-400 to-amber-400 pb-4;
  }
</style>
